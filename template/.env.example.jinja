# Local development: a lake under .lake/ (gitignored). Copy to .env; `just` loads it automatically.
# Worktrees get their own namespace automatically (their directory name), so they never share state.
DATAPLAT_CATALOG=duckdb:.lake/catalog/meta.ducklake
DATAPLAT_DATA_PATH=.lake/data/
DBOS_SYSTEM_DATABASE_URL=sqlite:///.lake/dbos.sqlite
GRAPH_DIR=.lake/graphs
SOURCE_DROP_DIR=.lake/drop

# Telemetry (optional): workflow spans and error logs, scrubbed of identifiers, to OpenObserve.
# `just observe` runs one locally (Docker) at http://localhost:5080 with these credentials.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
# OPENOBSERVE_USER=dev@example.com
# OPENOBSERVE_PASSWORD=pick-a-local-password
# OPENOBSERVE_ALERT_DESTINATION=dataplat    # create it once in OpenObserve before `just alerts --apply`

# Production values are injected by Infisical on the box (`infisical run -- ...`). Never write them here.
# DATAPLAT_CATALOG=postgres:dbname=lakecat host=postgres user=lake     # no password: libpq reads PGPASSWORD
# DATAPLAT_DATA_PATH={{ lake_data_path }}
# DATAPLAT_S3_ENDPOINT=rustfs:9000
# DATAPLAT_S3_URL_STYLE=path
# DBOS_SYSTEM_DATABASE_URL=postgresql://dbos@postgres/dbos_{{ package_name }}
# OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
# Secrets (Infisical only): PGPASSWORD, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, OPENOBSERVE_USER,
# OPENOBSERVE_PASSWORD
