# Paste into the Dokploy service's Environment tab and fill in. Dokploy keeps these on the server.
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
OPENOBSERVE_BUCKET=openobserve
OPENOBSERVE_USER=ops@example.org
OPENOBSERVE_PASSWORD=
OPENOBSERVE_BIND=127.0.0.1
OPENOBSERVE_PORT=5080
OPENOBSERVE_WEB_URL=http://localhost:5080
OPENOBSERVE_RETENTION_DAYS=30
OPENOBSERVE_VERSION=v1.0.4
