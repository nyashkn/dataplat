"""Live-fire the guardrails: plant one violation per test in a sandbox copy of this project's config,
and show the gate that should catch it does.

A lint rule nobody has seen fail is only a claim. These tests prove every gate in docs/CONVENTIONS.md
works against this repo's real ruff.toml, .importlinter, .jscpd.json, hooks and settings.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import textwrap
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[2]
PKG = "{{ package_name }}"
LAYERS = ("contracts", "sources", "transforms", "semantic", "graph", "actions", "pipelines", "cli")
BIN = Path(sys.executable).parent


def run(
    cmd: list[str], cwd: Path, stdin: str | None = None, env: dict[str, str] | None = None
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=cwd, input=stdin, capture_output=True, text=True, timeout=300, env=env)


@pytest.fixture
def sandbox(tmp_path: Path) -> Path:
    """This project's guardrail config over an empty package skeleton."""
    for name in ("pyproject.toml", "ruff.toml", ".importlinter", ".jscpd.json"):
        shutil.copy(ROOT / name, tmp_path / name)
    pkg = tmp_path / "src" / PKG
    for layer in LAYERS:
        (pkg / layer).mkdir(parents=True)
        (pkg / layer / "__init__.py").write_text("")
    (pkg / "__init__.py").write_text("")
    (pkg / "settings.py").write_text("")
    return tmp_path


def plant(sandbox: Path, rel: str, code: str) -> Path:
    path = sandbox / "src" / PKG / rel
    path.write_text(textwrap.dedent(code))
    return path


def ruff(sandbox: Path) -> subprocess.CompletedProcess[str]:
    return run([str(BIN / "ruff"), "check", "--no-cache", "--output-format", "concise", "src"], sandbox)


def dataplat_lint(sandbox: Path) -> subprocess.CompletedProcess[str]:
    return run([str(BIN / "dataplat"), "lint"], sandbox)


def lint_imports(sandbox: Path) -> subprocess.CompletedProcess[str]:
    env = {**os.environ, "PYTHONPATH": str(sandbox / "src")}
    return run([str(BIN / "lint-imports"), "--no-cache"], sandbox, env=env)


# ---------------------------------------------------------------- single writer
def test_parquet_writes_outside_the_writer_are_caught(sandbox: Path) -> None:
    plant(
        sandbox,
        "transforms/bad.py",
        "import pyarrow.parquet as pq\n\ndef f(t, df):\n    pq.write_table(t, 'x.parquet')\n    df.write_parquet('y.parquet')\n",
    )
    assert "TID251" in ruff(sandbox).stdout
    assert "DPA001" in dataplat_lint(sandbox).stdout


def test_sql_file_writes_are_caught(sandbox: Path) -> None:
    plant(
        sandbox,
        "semantic/bad.py",
        "def f(con):\n    con.execute(\"COPY (SELECT 1) TO 'out.parquet' (FORMAT parquet)\")\n",
    )
    assert "DPA002" in dataplat_lint(sandbox).stdout


def test_only_pipelines_may_import_the_writer(sandbox: Path) -> None:
    plant(sandbox, "semantic/bad.py", "from dataplat.lakecore.write import Writer\n")
    assert "DPA004" in dataplat_lint(sandbox).stdout
    (sandbox / "src" / PKG / "semantic" / "bad.py").unlink()
    plant(sandbox, "pipelines/ok.py", "from dataplat.lakecore.write import Writer\n")
    assert dataplat_lint(sandbox).returncode == 0


# ---------------------------------------------------------------- never list storage
def test_listing_storage_is_caught(sandbox: Path) -> None:
    plant(
        sandbox,
        "pipelines/bad.py",
        "import os\nfrom pathlib import Path\n\ndef f():\n    os.listdir('/lake')\n    Path('/lake').rglob('*.parquet')\n",
    )
    assert "TID251" in ruff(sandbox).stdout
    out = dataplat_lint(sandbox).stdout
    assert out.count("DPA003") >= 2


# ---------------------------------------------------------------- layers and purity
def test_layer_breach_is_caught(sandbox: Path) -> None:
    plant(sandbox, "transforms/bad.py", f"import {PKG}.pipelines\n")
    out = lint_imports(sandbox)
    assert out.returncode == 1 and "not allowed to import" in out.stdout


def test_sibling_layers_stay_independent(sandbox: Path) -> None:
    plant(sandbox, "semantic/bad.py", f"import {PKG}.graph\n")
    assert lint_imports(sandbox).returncode == 1


def test_transforms_stay_pure(sandbox: Path) -> None:
    plant(sandbox, "transforms/bad.py", "import duckdb\n")
    out = lint_imports(sandbox)
    assert out.returncode == 1 and "Transforms are pure" in out.stdout
    (sandbox / "src" / PKG / "transforms" / "bad.py").unlink()
    plant(sandbox, "transforms/bad2.py", "from dataplat.lakecore import connect\n")
    assert "DPA005" in dataplat_lint(sandbox).stdout


def test_clean_skeleton_passes_every_static_gate(sandbox: Path) -> None:
    plant(
        sandbox,
        "transforms/ok.py",
        "import polars as pl\n\n\ndef double(x: pl.DataFrame) -> pl.DataFrame:\n    return x\n",
    )
