# ---------------------------------------------------------------- ownership and box-only checks
def test_guardrails_are_owned_and_ask_before_edit() -> None:
    owners = (ROOT / ".github" / "CODEOWNERS").read_text()
    for path in (
        "/ruff.toml",
        "/.importlinter",
        "/.jscpd.json",
        "/justfile",
        "/pyproject.toml",
        "/.claude/",
        "/tests/architecture/",
    ):
        assert path in owners, path
    ask = set(json.loads((ROOT / ".claude" / "settings.json").read_text())["permissions"]["ask"])
    assert {
        "Edit(ruff.toml)",
        "Edit(.importlinter)",
        "Edit(justfile)",
        "Edit(pyproject.toml)",
        "Edit(tests/architecture/**)",
    } <= ask


def test_permission_rules_name_real_recipes() -> None:
    """A renamed recipe must not silently drop out of the allow, ask or deny lists."""
    just = BIN / "just"
    if not just.exists():
        pytest.skip("just not installed in the venv")
    recipes = set(run([str(just), "--summary"], ROOT).stdout.split())
    perms = json.loads((ROOT / ".claude" / "settings.json").read_text())["permissions"]
    named = 0
    for kind in ("allow", "ask", "deny"):
        for rule in perms[kind]:
            m = re.fullmatch(r"Bash\((?:uv run --frozen )?just(?: ([a-z][\w-]*))?.*\)", rule)
            if m and m.group(1):
                named += 1
                assert m.group(1) in recipes, f"{kind}: {rule}"
    assert named > 10
    allowed = " ".join(perms["allow"])
    assert "verify-prod" not in allowed and "worktree" not in allowed
    assert {"Bash(just cli approve *)", "Bash(uv run --frozen just cli approve *)"} <= set(perms["deny"])


def test_recipe_arguments_are_never_spliced_raw() -> None:
    """A parameter pasted straight into a shell line re-splits on spaces and runs any shell syntax in it.
    Recipes pass arguments through `[positional-arguments]` + "$@", or quote()."""
    just = BIN / "just"
    if not just.exists():
        pytest.skip("just not installed in the venv")
    dump = json.loads(run([str(just), "--dump", "--dump-format", "json"], ROOT).stdout)
    raw = [
        f"{name}({param['name']})"
        for name, recipe in dump["recipes"].items()
        for param in recipe["parameters"]
        for line in recipe["body"]
        for fragment in line
        if fragment == [["variable", param["name"]]]
    ]
    assert raw == [], raw
    assert "positional-arguments" in dump["recipes"]["cli"]["attributes"]


def test_prod_checks_never_run_outside_the_box() -> None:
    import importlib.util

    spec = importlib.util.spec_from_file_location("select_tests", ROOT / "scripts" / "select_tests.py")
    assert spec and spec.loader
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    picked = mod.select(["tests/prod/test_prod_lake.py", f"src/{PKG}/pipelines/x.py"], ROOT)
    assert not any(p.startswith("tests/prod") for p in picked)
    env = {k: v for k, v in os.environ.items() if k != "DATAPLAT_ON_BOX"}
    out = run(
        [sys.executable, "-m", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider", "tests"],
        ROOT,
        env=env,
    )
    assert "tests/prod" not in out.stdout
