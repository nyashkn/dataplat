# ---------------------------------------------------------------- duplication backstop
@pytest.mark.needs_node
def test_new_duplicate_code_fails_the_ratchet(sandbox: Path) -> None:
    if shutil.which("npx") is None:
        pytest.skip("node/npx not installed")
    body = "\n".join(f"    total_{i} = sum(v * {i} for v in values if v > {i})" for i in range(12))
    plant(sandbox, "transforms/a.py", f"def score_a(values):\n{body}\n    return total_1\n")
    git = ["git", "-c", "user.email=t@t", "-c", "user.name=t"]
    run([*git, "init", "-q", "-b", "main"], sandbox)
    run([*git, "add", "-A"], sandbox)
    run([*git, "commit", "-q", "-m", "base"], sandbox)
    renamed = body.replace("total_", "acc_").replace("values", "items")
    plant(sandbox, "semantic/b.py", f"def score_b(items):\n{renamed}\n    return acc_1\n")
    out = run(
        [
            "npx",
            "-y",
            "jscpd@5.3.2",
            "--config",
            ".jscpd.json",
            "--baseline-from-ref",
            "main",
            "--fail-on-new-clones",
            "0",
            "src",
        ],
        sandbox,
    )
    assert out.returncode == 1, out.stdout[-2000:]
    assert "new clones" in (out.stdout + out.stderr)


# ---------------------------------------------------------------- contracts
def test_stale_generated_contracts_are_caught(tmp_path: Path) -> None:
    shutil.copy(ROOT / "pyproject.toml", tmp_path / "pyproject.toml")
    shutil.copytree(ROOT / "src" / PKG / "contracts", tmp_path / "src" / PKG / "contracts")
    assert run([str(BIN / "dataplat"), "contracts", "check"], tmp_path).returncode == 0
    yaml = tmp_path / "src" / PKG / "contracts" / "ontology.yaml"
    yaml.write_text(yaml.read_text().replace("description:", "description: CHANGED", 1))
    out = run([str(BIN / "dataplat"), "contracts", "check"], tmp_path)
    assert out.returncode == 1 and "STALE" in out.stdout


# ---------------------------------------------------------------- live-fire gate
def test_a_check_without_live_fire_fails_the_suite(tmp_path: Path) -> None:
    (tmp_path / "lfpkg").mkdir()
    (tmp_path / "lfpkg" / "__init__.py").write_text("")
    (tmp_path / "lfpkg" / "rules.py").write_text(
        "import polars as pl\nfrom dataplat.checks import check\n\n@check\ndef never_fired() -> pl.Expr:\n"
        "    '''x is positive.'''\n    return pl.col('x') > 0\n"
    )
    (tmp_path / "test_nothing.py").write_text("def test_ok():\n    assert True\n")
    (tmp_path / "pytest.ini").write_text("[pytest]\ndataplat_check_packages = lfpkg\n")
    out = run([sys.executable, "-m", "pytest", "-q", "--livefire-strict", "-p", "no:cacheprovider"], tmp_path)
    assert out.returncode == 1 and "never_fired" in out.stdout


# ---------------------------------------------------------------- agent hooks and permissions
@pytest.mark.parametrize(
    ("command", "blocked"),
    [
        ("printenv", True),
        ("env | grep KEY", True),
        ("cat .env", True),
        ("infisical secrets list", True),
        ("git push --force origin main", True),
        ("git commit -n -m wip", True),
        ("infisical run -- env", True),
        ("echo $(env)", True),
        ("sudo env", True),
        ("export -p", True),
        ("SKIP=gitleaks git commit -m wip", True),
        ("git -c core.hooksPath=/dev/null commit -m wip", True),
        ("git commit -nm wip", True),
        ("{{ cli_name }} approve 1234", True),
        ("just cli approve 1234", True),
        ("uv run --frozen just cli approve 1234 --by me", True),
        ("cat .env.example", False),
        ("env DATAPLAT_NS=x just test", False),
        ("just cli census", False),
        ("just test", False),
        ("git push --force-with-lease origin wt/feat", False),
        ("uv run --frozen pytest -q", False),
    ],
)
def test_bash_guard(command: str, blocked: bool) -> None:
    payload = json.dumps({"tool_name": "Bash", "tool_input": {"command": command}})
    out = run([sys.executable, str(ROOT / ".claude" / "hooks" / "guard_bash.py")], ROOT, stdin=payload)
    assert (out.returncode == 2) is blocked, out.stderr


def test_settings_deny_secret_reads() -> None:
    settings = json.loads((ROOT / ".claude" / "settings.json").read_text())
    deny = set(settings["permissions"]["deny"])
    assert {"Read(.env)", "Bash(printenv)", "Bash(infisical secrets *)", "Bash(git push --force *)"} <= deny
    hooks = settings["hooks"]
    assert "guard_bash.py" in json.dumps(hooks["PreToolUse"]) and "post_edit.py" in json.dumps(
        hooks["PostToolUse"]
    )


def test_post_edit_hook_reports_architecture_violations(sandbox: Path) -> None:
    (sandbox / ".venv").symlink_to(ROOT / ".venv")
    bad = plant(sandbox, "transforms/bad.py", "def f(df):\n    df.write_parquet('x.parquet')\n")
    payload = json.dumps({"tool_name": "Write", "tool_input": {"file_path": str(bad)}})
    env = {**os.environ, "CLAUDE_PROJECT_DIR": str(sandbox)}
    out = run(
        [sys.executable, str(ROOT / ".claude" / "hooks" / "post_edit.py")], sandbox, stdin=payload, env=env
    )
    assert out.returncode == 2 and "DPA001" in out.stderr


