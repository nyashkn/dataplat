"""Business rules for usage events, ported from an earlier pipeline (``src/usage/backfill/schema.py``).

In the old pipeline these validators were only ever called from a test; production never ran them
(docs/traps.md). Here they are bound to the contract, so every commit runs them, and each one has a
live-fire test showing it catches the incident it is named after.
"""

import polars as pl
from dataplat.checks import check

from {{ package_name }}.contracts._generated import tables

TELCO_PREFIXES = ("BD_TELCO_", "PS_TELCO_")


@check(origin="earlier-pipeline backfill/schema.py V6")
def v6_phone_only_on_telco() -> pl.Expr:
    """V6: phone_number is set only on telco use types (BD_TELCO_*, PS_TELCO_*)."""
    telco = pl.any_horizontal([pl.col("use_type").str.starts_with(p) for p in TELCO_PREFIXES]).fill_null(
        False
    )
    return pl.col("phone_number").is_null() | telco


@check(origin="issues #160, #176")
def v21_phone_no_leading_plus() -> pl.Expr:
    """V21: phone_number never starts with '+'."""
    return ~pl.col("phone_number").str.starts_with("+").fill_null(False)


@check(origin="issue #197: ~3.83M rows in 2023-08/09 shaped 9{12}.9")
def v24_phone_no_dot() -> pl.Expr:
    """V24: phone_number never contains '.' (float artifacts from a spreadsheet round-trip)."""
    return ~pl.col("phone_number").str.contains(".", literal=True).fill_null(False)


# The contract as pipelines commit it: generated shape + the business rules above.
USAGE_EVENT = tables.USAGE_EVENT.with_checks(
    v6_phone_only_on_telco, v21_phone_no_leading_plus, v24_phone_no_dot
)
